# Supabase project settings → API keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Used by the admin page to create users. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_...
# Server-only. Claude Haiku fills in wishes from shop links and screenshots
# (Wunsch-Liste). Without it, only the page's preview data (title, image,
# price) is used and screenshots can't be read.
ANTHROPIC_API_KEY=sk-ant-...
# Optional. Your Amazon partner tag (e.g. yourname-21). Added to Amazon links
# that guests open on a shared wishlist, with the required disclosure.
AMAZON_PARTNER_TAG=
